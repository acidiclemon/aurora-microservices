# -----------------------------------------------------------------------------
# Okta Configuration
# -----------------------------------------------------------------------------

# The OIDC client ID from Okta
okta_client_id = "your_client_id_here"

# The OIDC client secret from Okta
okta_client_secret = "your_client_secret_here"

# The OIDC issuer URL
okta_issuer = "https://<your-okta-domain>/oauth2/default"

# The Okta authorization endpoint URL
okta_authorization_endpoint = "https://<your-okta-domain>/oauth2/default/v1/authorize"

# The Okta token endpoint URL
okta_token_endpoint = "https://<your-okta-domain>/oauth2/default/v1/token"

# The Okta user info endpoint URL
okta_user_info_endpoint = "https://<your-okta-domain>/oauth2/default/v1/userinfo"


# -----------------------------------------------------------------------------
# DNS & HTTPS Configuration
# -----------------------------------------------------------------------------

# The Route 53 Hosted Zone name for your domain (e.g., example.com)
route53_zone_name = "example.com"

# The sub-domain intended for the application (e.g., echo.example.com)
alb_record_name = "echo.example.com"

# The domain name of the ACM certificate to attach to the ALB
acm_certificate_domain = "example.com"
